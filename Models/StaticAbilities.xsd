<?xml version="1.0"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:abi="Abilities"
    xmlns:sa="StaticAbilities"
    targetNamespace="StaticAbilities"
    elementFormDefault="qualified"
>
    <xs:import
        namespace="Abilities"
        schemaLocation="Abilities.xsd"
    />
    <xs:complexType name="StaticAbility" abstract="true">
        <xs:complexContent>
            <xs:extension base="abi:Ability" />
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="BlockerAbility">
        <xs:complexContent>
            <xs:extension base="sa:StaticAbility" />
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="ShieldTriggerAbility">
        <xs:complexContent>
            <xs:extension base="sa:StaticAbility" />
        </xs:complexContent>
    </xs:complexType>
</xs:schema>