<?xml version="1.0"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:cf="CardFilters"
    targetNamespace="CardFilters"
    elementFormDefault="qualified">
    <xs:complexType name="CardFilter"/>
    <xs:complexType name="CreatureFilter">
        <xs:complexContent>
            <xs:extension base="cf:CardFilter" />
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="BlockerFilter">
        <xs:complexContent>
            <xs:extension base="cf:CreatureFilter" />
        </xs:complexContent>
    </xs:complexType>
</xs:schema>