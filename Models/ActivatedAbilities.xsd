<?xml version="1.0"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:abi="Abilities"
    xmlns:aa="ActivatedAbilities"
    targetNamespace="ActivatedAbilities"
    elementFormDefault="qualified"
>
    <xs:import
        namespace="Abilities"
        schemaLocation="Abilities.xsd"
    />
    <xs:complexType name="ActivatedAbility" abstract="true">
        <xs:complexContent>
            <xs:extension base="abi:ResolvableAbility" />
        </xs:complexContent>
    </xs:complexType>
    <xs:complexType name="TapAbility">
        <xs:complexContent>
            <xs:extension base="aa:ActivatedAbility" />
        </xs:complexContent>
    </xs:complexType>
</xs:schema>