<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="cards">
          <xs:complexType>
            <xs:choice maxOccurs="unbounded">
              <xs:element type="creature" name="creature" />
              <xs:element type="spell" name="spell" />
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="card" abstract="true">
    <xs:sequence>
      <xs:element name="name" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="creature">
    <xs:complexContent>
      <xs:extension base="card">
        <xs:sequence>
          <xs:element name="power" type="xs:integer" />
          <xs:element name="triggeredAbilities" minOccurs="0">
            <xs:complexType>
              <xs:choice maxOccurs="unbounded">
                <xs:element type="whenYouPutThisCreatureIntoTheBattleZoneAbility"
                  name="whenYouPutThisCreatureIntoTheBattleZoneAbility" />
              </xs:choice>
            </xs:complexType>
          </xs:element>
          <xs:element name="activatedAbilities" minOccurs="0">
            <xs:complexType>
              <xs:choice maxOccurs="unbounded">
                <xs:element type="tapAbility" name="tapAbility" />
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="spell">
    <xs:complexContent>
      <xs:extension base="card">
        <xs:sequence>
          <xs:element name="spellAbilities">
            <xs:complexType>
              <xs:sequence>
                <xs:element type="spellAbility" name="spellAbility"></xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ability" abstract="true" />
  <xs:complexType name="resolvableAbility" abstract="true">
    <xs:complexContent>
      <xs:extension base="ability">
        <xs:choice>
          <xs:element type="destroyOneOfYourOpponentsCreaturesEffect"
            name="destroyOneOfYourOpponentsCreaturesEffect" />
          <xs:element type="tapAllYourOpponentsCreaturesEffect"
            name="tapAllYourOpponentsCreaturesEffect" />
          <xs:element type="youMayDrawCardEffect"
            name="youMayDrawCardEffect" />
            <xs:element type="destroyOneOfYourOpponentsCreaturesThatHasBlockerEffect"
            name="destroyOneOfYourOpponentsCreaturesThatHasBlockerEffect" />
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="spellAbility">
    <xs:complexContent>
      <xs:extension base="resolvableAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="triggeredAbility" abstract="true">
    <xs:complexContent>
      <xs:extension base="resolvableAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="whenYouPutThisCreatureIntoTheBattleZoneAbility">
    <xs:complexContent>
      <xs:extension base="triggeredAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="activatedAbility" abstract="true">
    <xs:complexContent>
      <xs:extension base="resolvableAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="tapAbility">
    <xs:complexContent>
      <xs:extension base="activatedAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="oneShotEffect" abstract="true" />
  <xs:complexType name="destroyOneOfYourOpponentsCreaturesEffect">
    <xs:complexContent>
      <xs:extension base="oneShotEffect" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="tapAllYourOpponentsCreaturesEffect">
    <xs:complexContent>
      <xs:extension base="oneShotEffect" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="youMayDrawCardEffect">
    <xs:complexContent>
      <xs:extension base="oneShotEffect" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="destroyOneOfYourOpponentsCreaturesThatHasBlockerEffect">
    <xs:complexContent>
      <xs:extension base="oneShotEffect" />
    </xs:complexContent>
  </xs:complexType>
</xs:schema>