<?xml version="1.0"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="urn:Cards"
  xmlns:ose="urn:OneShotEffects"
  targetNamespace="urn:Cards"
  elementFormDefault="qualified"
  >
  <xs:import
    namespace="urn:OneShotEffects"
    schemaLocation="oneShotEffect.xsd"
    />
  <xs:element name="Root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Cards">
          <xs:complexType>
            <xs:choice maxOccurs="unbounded">
              <xs:element type="Creature" name="Creature" />
              <xs:element type="Spell" name="Spell" />
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Card" abstract="true">
    <xs:sequence>
      <xs:element name="Name" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Creature">
    <xs:complexContent>
      <xs:extension base="Card">
        <xs:sequence>
          <xs:element name="Power" type="xs:integer" />
          <xs:element name="TriggeredAbilities" minOccurs="0">
            <xs:complexType>
              <xs:choice maxOccurs="unbounded">
                <xs:element type="WhenYouPutThisCreatureIntoTheBattleZoneAbility"
                  name="WhenYouPutThisCreatureIntoTheBattleZoneAbility" />
              </xs:choice>
            </xs:complexType>
          </xs:element>
          <xs:element name="ActivatedAbilities" minOccurs="0">
            <xs:complexType>
              <xs:choice maxOccurs="unbounded">
                <xs:element type="TapAbility" name="TapAbility" />
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Spell">
    <xs:complexContent>
      <xs:extension base="Card">
        <xs:sequence>
          <xs:element name="SpellAbilities">
            <xs:complexType>
              <xs:sequence>
                <xs:element type="SpellAbility" name="SpellAbility"></xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Ability" abstract="true" />
  <xs:complexType name="ResolvableAbility" abstract="true">
    <xs:complexContent>
      <xs:extension base="Ability">
        <xs:choice>
          <xs:element type="ose:DestroyOneOfYourOpponentsCreaturesEffect"
            name="DestroyOneOfYourOpponentsCreaturesEffect" />
          <xs:element type="ose:TapAllYourOpponentsCreaturesEffect"
            name="TapAllYourOpponentsCreaturesEffect" />
          <xs:element type="ose:YouMayDrawCardEffect"
            name="YouMayDrawCardEffect" />
          <xs:element type="ose:DestroyOneOfYourOpponentsCreaturesThatHasBlockerEffect"
            name="DestroyOneOfYourOpponentsCreaturesThatHasBlockerEffect" />
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="SpellAbility">
    <xs:complexContent>
      <xs:extension base="ResolvableAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="TriggeredAbility" abstract="true">
    <xs:complexContent>
      <xs:extension base="ResolvableAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="WhenYouPutThisCreatureIntoTheBattleZoneAbility">
    <xs:complexContent>
      <xs:extension base="TriggeredAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ActivatedAbility" abstract="true">
    <xs:complexContent>
      <xs:extension base="ResolvableAbility" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="TapAbility">
    <xs:complexContent>
      <xs:extension base="ActivatedAbility" />
    </xs:complexContent>
  </xs:complexType>
</xs:schema>