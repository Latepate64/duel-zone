<?xml version="1.0"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="Cards"
  xmlns:abi="Abilities"
  xmlns:ta="TriggeredAbilities"
  xmlns:aa="ActivatedAbilities"
  xmlns:sa="StaticAbilities"
  targetNamespace="Cards"
  elementFormDefault="qualified"
>
  <xs:import
    namespace="Abilities"
    schemaLocation="Abilities.xsd"
  />
  <xs:import
    namespace="TriggeredAbilities"
    schemaLocation="TriggeredAbilities.xsd"
  />
  <xs:import
    namespace="ActivatedAbilities"
    schemaLocation="ActivatedAbilities.xsd"
  />
  <xs:import
    namespace="StaticAbilities"
    schemaLocation="StaticAbilities.xsd"
  />
  <xs:element name="Root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Cards">
          <xs:complexType>
            <xs:choice maxOccurs="unbounded">
              <xs:element type="Creature" name="Creature" />
              <xs:element type="Spell" name="Spell" />
            </xs:choice>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="Card" abstract="true">
    <xs:sequence>
      <xs:element name="Civilizations">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="Civilization" minOccurs="1" maxOccurs="5">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="Light" />
                  <xs:enumeration value="Water" />
                  <xs:enumeration value="Darkness" />
                  <xs:enumeration value="Fire" />
                  <xs:enumeration value="Nature" />
                </xs:restriction>
              </xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="Name" type="xs:string" use="required" />
    <xs:attribute name="Cost" type="xs:integer" use="required" />
  </xs:complexType>
  <xs:complexType name="Creature">
    <xs:complexContent>
      <xs:extension base="Card">
        <xs:sequence>
          <xs:element name="Races">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Race" minOccurs="1" maxOccurs="2">
                  <xs:simpleType>
                    <xs:restriction base="xs:string">
                      <xs:enumeration value="Beast Folk" />
                      <xs:enumeration value="Human" />
                      <xs:enumeration value="Leviathan" />
                      <xs:enumeration value="Liquid People" />
                      <xs:enumeration value="Xenoparts" />
                    </xs:restriction>
                  </xs:simpleType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
          <xs:element name="Abilities">
            <xs:complexType>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element type="ta:WhenYouPutThisCreatureIntoTheBattleZoneAbility"
                  name="WhenYouPutThisCreatureIntoTheBattleZoneAbility" />
                <xs:element type="aa:TapAbility" name="TapAbility" />
                <xs:element type="sa:BlockerAbility" name="BlockerAbility" />
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
        <xs:attribute name="Power" type="xs:integer" use="required" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Spell">
    <xs:complexContent>
      <xs:extension base="Card">
        <xs:sequence>
          <xs:element name="Abilities">
            <xs:complexType>
              <xs:sequence>
                <xs:element type="abi:SpellAbility" name="SpellAbility"></xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>