<?xml version="1.0"?>
<Root
    xmlns="Cards"
    xmlns:abi="Abilities"
    xmlns:ose="OneShotEffects"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="Cards ./Cards.xsd
                        Abilities ./Abilities.xsd
                        OneShotEffects ./OneShotEffects.xsd"
>
    <Cards>
        <Creature>
            <Name>Burning Mane</Name>
            <Power>2000</Power>
        </Creature>
        <Spell>
            <Name>Holy Awe</Name>
            <SpellAbilities>
                <SpellAbility>
                    <abi:TapAllYourOpponentsCreaturesEffect />
                </SpellAbility>
            </SpellAbilities>
        </Spell>
        <Creature>
            <Name>Immortal Baron, Vorg</Name>
            <Power>2000</Power>
        </Creature>
        <Spell>
            <Name>Terror Pit</Name>
            <SpellAbilities>
                <SpellAbility>
                    <abi:DestroyOneOfYourOpponentsCreaturesEffect />
                </SpellAbility>
            </SpellAbilities>
        </Spell>
        <Creature>
            <Name>Aqua Hulcus</Name>
            <Power>2000</Power>
            <TriggeredAbilities>
                <WhenYouPutThisCreatureIntoTheBattleZoneAbility>
                    <abi:YouMayDrawCardEffect />
                </WhenYouPutThisCreatureIntoTheBattleZoneAbility>
            </TriggeredAbilities>
        </Creature>
        <Creature>
            <Name>Rikabu's Screwdriver</Name>
            <Power>1000</Power>
            <ActivatedAbilities>
                <TapAbility>
                    <abi:DestroyOneOfYourOpponentsCreaturesThatHasBlockerEffect />
                </TapAbility>
            </ActivatedAbilities>
        </Creature>
    </Cards>
</Root>